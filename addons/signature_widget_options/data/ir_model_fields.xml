        <field name="model_id" ref="base.model_res_company"/>
        <field name="name">x_signature_frontend_mode_auto</field>
        <field name="field_description">Frontend signature: Auto</field>
        <field name="help">Offer the 'Auto' mode (signature generated from the typed name) on portal and website pages.</field>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
