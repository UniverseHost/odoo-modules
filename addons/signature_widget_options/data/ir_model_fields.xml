<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="field_res_company_x_signature_backend_mode_draw" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_company"/>
        <field name="name">x_signature_backend_mode_draw</field>
        <field name="field_description">Backend signature: Draw</field>
        <field name="help">Offer the 'Draw' mode (the user draws the signature by hand) in the web client.</field>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
    </record>

    <record id="field_res_company_x_signature_backend_mode_auto" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_company"/>
        <field name="name">x_signature_backend_mode_auto</field>
        <field name="field_description">Backend signature: Auto</field>
        <field name="help">Offer the 'Auto' mode (signature generated from the typed name) in the web client.</field>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
    </record>

    <record id="field_res_company_x_signature_backend_mode_load" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_company"/>
        <field name="name">x_signature_backend_mode_load</field>
        <field name="field_description">Backend signature: Load</field>
        <field name="help">Offer the 'Load' mode (upload an image file) in the web client.</field>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
    </record>

    <record id="field_res_company_x_signature_frontend_mode_draw" model="ir.model.fields">
