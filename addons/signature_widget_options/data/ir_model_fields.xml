        <field name="field_description">Frontend signature: Draw</field>
        <field name="help">Offer the 'Draw' mode (the visitor draws the signature by hand) on portal and website pages.</field>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
