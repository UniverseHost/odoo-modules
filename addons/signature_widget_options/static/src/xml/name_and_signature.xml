<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.NameAndSignature" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o_web_sign_signature_group')]" position="attributes">
            <attribute name="t-if">state.showSignatureArea and hasAnySignMode</attribute>
        </xpath>

        <xpath expr="//a[contains(@t-attf-class, 'o_web_sign_auto_button')]/.." position="attributes">
            <attribute name="t-if">allowedSignModes.auto</attribute>
        </xpath>

        <xpath expr="//a[contains(@t-attf-class, 'o_web_sign_draw_button')]/.." position="attributes">
            <attribute name="t-if">allowedSignModes.draw</attribute>
        </xpath>

        <xpath expr="//a[contains(@t-attf-class, 'o_web_sign_load_button')]/.." position="attributes">
            <attribute name="t-if">allowedSignModes.load</attribute>
        </xpath>

    </t>

</templates>
