<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.signature.widget.options</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <div id="signature_widget_options">
                    <block title="Signature Widget (Backend)"
                           name="signature_widget_backend_container"
                           help="Modes offered by the generic signature widget inside the web client. Unchecking all of them disables signature input in the backend.">
                        <setting id="x_signature_backend_mode_draw_setting"
                                 string="Draw"
                                 help="Let the user draw the signature by hand.">
                            <field name="x_signature_backend_mode_draw"/>
                        </setting>
                        <setting id="x_signature_backend_mode_auto_setting"
                                 string="Auto"
                                 help="Let the user generate the signature from the typed name.">
                            <field name="x_signature_backend_mode_auto"/>
                        </setting>
                        <setting id="x_signature_backend_mode_load_setting"
                                 string="Load"
                                 help="Let the user upload an image file as signature.">
                            <field name="x_signature_backend_mode_load"/>
                        </setting>
                    </block>
                    <block title="Signature Widget (Frontend)"
                           name="signature_widget_frontend_container"
                           help="Modes offered by the generic signature widget on portal and website pages. Unchecking all of them disables signature input in the frontend.">
                        <setting id="x_signature_frontend_mode_draw_setting"
                                 string="Draw"
                                 help="Let the visitor draw the signature by hand.">
                            <field name="x_signature_frontend_mode_draw"/>
                        </setting>
                        <setting id="x_signature_frontend_mode_auto_setting"
                                 string="Auto"
                                 help="Let the visitor generate the signature from the typed name.">
                            <field name="x_signature_frontend_mode_auto"/>
                        </setting>
                        <setting id="x_signature_frontend_mode_load_setting"
                                 string="Load"
                                 help="Let the visitor upload an image file as signature.">
                            <field name="x_signature_frontend_mode_load"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
