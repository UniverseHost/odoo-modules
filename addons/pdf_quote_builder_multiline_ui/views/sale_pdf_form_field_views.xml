<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_pdf_form_field_list_multiline" model="ir.ui.view">
        <field name="name">sale.pdf.form.field.list.multiline</field>
        <field name="model">sale.pdf.form.field</field>
        <field name="inherit_id" ref="sale_pdf_quote_builder.sale_pdf_form_field_list"/>
        <field name="arch" type="xml">
            <field name="document_type" position="after">
                <field name="x_is_multiline" optional="show" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="sale_pdf_form_field_search_multiline" model="ir.ui.view">
        <field name="name">sale.pdf.form.field.search.multiline</field>
        <field name="model">sale.pdf.form.field</field>
        <field name="inherit_id" ref="sale_pdf_quote_builder.quotation_document_search"/>
        <field name="arch" type="xml">
            <filter name="customizable" position="after">
                <filter
                    name="multiline"
                    string="Multiline"
                    domain="[('x_is_multiline', '=', True)]"
                />
            </filter>
        </field>
    </record>

</odoo>
